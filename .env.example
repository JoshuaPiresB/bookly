# Gere valores locais seguros com: npm run env:init
NODE_ENV=development
POSTGRES_USER=bookly
POSTGRES_PASSWORD=
POSTGRES_DB=bookly
POSTGRES_PORT=5432
DATABASE_URL=
# Opcional: conexão direta para migrations se DATABASE_URL usar pooler.
DIRECT_URL=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Login com Google OAuth. Preencha os dois valores ou deixe ambos vazios.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=
# Recuperação de senha. Em desenvolvimento, sem chave, o link aparece no terminal.
RESEND_API_KEY=
RESEND_FROM=Bookly <nao-responda@seu-dominio.com>
PASSWORD_RESET_TTL_MINUTES=30
# Seed: exige habilitação explícita, banco local e NODE_ENV=development.
ALLOW_DEV_SEED=false
SEED_EMAIL=demo@bookly.local
SEED_PASSWORD=
# Banco separado, com nome terminado em _test, para testes de integração.
TEST_DATABASE_URL=
# Opcional para testes E2E em navegador já instalado: msedge ou chrome.
PLAYWRIGHT_CHANNEL=
